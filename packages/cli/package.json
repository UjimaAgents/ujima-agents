{
  "name": "ujima",
  "version": "0.0.59",
  "private": true,
  "main": "./dist/main.js",
  "bin": {
    "ujima": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "@ujima/api-schema": "workspace:*",
    "@ujima/framework": "workspace:*",
    "@ujima/orchestrator": "workspace:*",
    "@ujima/runtime-core": "workspace:*",
    "@ujima/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
