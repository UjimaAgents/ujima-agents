{
  "name": "@ujima/webview",
  "version": "0.0.50",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "dev:browser": "vite --open /dev-harness.html?view=governance",
