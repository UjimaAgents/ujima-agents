{
  "name": "@ujima/api",
  "version": "0.0.52",
  "private": true,
  "main": "./dist/main.js",
  "bin": {
    "ujima-runtime": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "predev": "bun ../../scripts/free-port.ts ${UJIMA_PORT:-7511}",
    "build": "tsc -p tsconfig.json",
    "dev": "UJIMA_AGENT_LOOP_LOGS=1 bun --watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/multipart": "8.x",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^1.10.0",
    "@ujima/agent-runtime": "workspace:*",
    "@ujima/api-schema": "workspace:*",
    "@ujima/client-sdk": "workspace:*",
    "@ujima/context-store": "workspace:*",
    "@ujima/event-bus": "workspace:*",
    "@ujima/framework": "workspace:*",
    "@ujima/llm": "workspace:*",
    "@ujima/mcp-client": "workspace:*",
    "@ujima/orchestrator": "workspace:*",
    "@ujima/permissions": "workspace:*",
    "@ujima/runtime-core": "workspace:*",
    "@ujima/shared": "workspace:*",
    "better-sqlite3": "^12.9.0",
    "chalk": "^5.6.2",
    "fastify": "^4.28.1",
    "fastify-type-provider-zod": "^2.0.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@types/node": "^20.14.0",
    "ai": "^6.0.168",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
