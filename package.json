{
  "name": "ujima-agents",
  "version": "0.0.60",
  "private": true,
  "packageManager": "bun@1.3.11",
  "description": "Framework for building Slack-like teams of AI agents, with roles and workspace-bounded execution.",
  "trustedDependencies": ["better-sqlite3"],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "release:prepare": "bun scripts/release/prepare.ts",
    "release:check": "bun scripts/release/check.ts",
    "release:dist": "bun scripts/release/assemble-dist.ts",
    "release:platform-tarballs": "bun scripts/release/assemble-platform-tarballs.ts",
    "release:pack": "bun scripts/release/pack.ts",
    "release:publish": "npm publish -w @ujima/agents --access public",
    "release:smoke": "bun scripts/release/smoke-pack.ts",
    "release:e2e": "bun scripts/release/e2e-pack.ts",
    "dev": "turbo run dev --concurrency=24",
    "dev:stack": "turbo run dev --filter=web --filter=@ujima/api --concurrency=8",
    "dev:local": "bash scripts/dev-local.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun run build && vitest run --minWorkers=1 --maxWorkers=4",
    "test:ci": "vitest run --minWorkers=1 --maxWorkers=4",
    "test:unit:ci": "vitest run --minWorkers=1 --maxWorkers=4 --exclude '**/*.int.test.ts' --exclude '**/*.integration.test.ts'",
    "test:integration:ci": "vitest run --minWorkers=1 --maxWorkers=4 'int.test.ts' 'integration.test.ts'",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "verify:thorough": "bun run verify && bun run test:e2e",
    "verify:full": "bun run verify:thorough && bun run test:e2e",
    "prepush": "bun run verify:thorough",
    "codegen:webview": "playwright codegen http://localhost:5173/dev-harness.html?view=governance",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@ujima/framework": "workspace:*",
    "@playwright/test": "^1.46.0",
    "@tailwindcss/postcss": "4",
    "@ujima/mcp-client": "workspace:*",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "tailwindcss": "4",
    "esbuild": "^0.28.0",
    "turbo": "^2.0.14",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^1.0.15",
    "better-sqlite3": "12.9.0"
  }
}
