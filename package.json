{
  "name": "ujima-agents",
  "version": "0.1.0-alpha.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "description": "An agent operating system for your editor.",
  "trustedDependencies": ["better-sqlite3"],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=100",
    "dev:local": "bash scripts/dev-local.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "verify:thorough": "bun run verify && bun run build",
    "verify:full": "bun run verify:thorough && bun run test:e2e",
    "prepush": "bun run verify:thorough",
    "codegen:webview": "playwright codegen http://localhost:5173/dev-harness.html?view=governance",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.46.0",
    "@tailwindcss/postcss": "4",
    "@ujima/mcp-client": "workspace:*",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "tailwindcss": "4",
    "turbo": "^2.0.14",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^1.0.15",
    "better-sqlite3": "^12.9.0"
  }
}
